generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TelegramUser {
  id         String       @id @default(cuid())
  telegramId BigInt       @unique
  name       String?
  accesses   UserAccess[]
}

model UserAccess {
  id                   String             @id @default(cuid())
  userId               String
  residentialComplexId String
  residentialComplex   ResidentialComplex @relation(fields: [residentialComplexId], references: [id])
  user                 TelegramUser       @relation(fields: [userId], references: [id])

  @@unique([userId, residentialComplexId])
}

model ResidentialComplex {
  id                 String            @id @default(cuid())
  name               String
  shortName          String?
  dahApiKeyEncrypted String?
  createdAt          DateTime          @default(now())
  premises           Premises[]
  accesses           UserAccess[]
  buildingSections   BuildingSection[]
}

/// Під'їзд будинку. Редагуй прапорці в Prisma Studio (Bob).
model BuildingSection {
  id                   String @id @default(cuid())
  residentialComplexId String

  /// Для зручного перегляду в Bob, наприклад: Синергія Лайт · буд. 289А · під'їзд 1
  address String

  complexName    String
  buildingNumber String
  sectionNumber  String

  /// Котельня. false = немає ГВ і опалення в цьому під'їзді
  hasBoilerRoom Boolean @default(true)

  /// true = індивідуальні договори ЕЕ → ЕЕ не знімаємо обходом
  individualElectricityContracts Boolean @default(false)

  /// true = індивідуальні договори ХВ → ХВ не знімаємо обходом
  individualColdWaterContracts Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id])

  @@unique([residentialComplexId, buildingNumber, sectionNumber])
  @@index([residentialComplexId, buildingNumber])
}

model Premises {
  id                   String              @id @default(cuid())
  dahId                String              @unique
  name                 String
  createdAt            DateTime            @default(now())
  number               String?
  apartmentNumber      String?
  apartmentType        String?
  buildingId           String?
  buildingNumber       String?
  floor                Int?
  sectionNumber        String?
  sectionType          String?
  residentialComplexId String?
  counters             Meter[]
  residentialComplex   ResidentialComplex? @relation(fields: [residentialComplexId], references: [id])
}

model Meter {
  id           String    @id @default(cuid())
  dahId        String    @unique
  premisesId   String
  name         String
  serialNumber String?
  createdAt    DateTime  @default(now())
  resourceType String
  premises     Premises  @relation(fields: [premisesId], references: [id])
  readings     Reading[]
  details      MeterDetail[]
}

model MeterDetail {
  id                     String    @id @default(cuid())
  snapshotDate           DateTime
  serialNumber           String
  manufacturer           String?
  deviceType             String?
  deviceVersion          Int?
  deviceStatus           String
  requestedAt            String?
  deviceAt               String?
  energy                 Float?
  energyUnit             String?
  volume                 Float?
  volumeUnit             String?
  power                  Float?
  powerUnit              String?
  flow                   Float?
  flowUnit               String?
  temperature1           Float?
  temperature1Unit       String?
  temperature2           Float?
  temperature2Unit       String?
  temperatureDifference  Float?
  temperatureDifferenceUnit String?
  errorFlag              Int?
  statusField            String?
  operatingTime          Int?
  operatingTimeUnit      String?
  operatingTimeWithError Int?
  operatingTimeWithErrorUnit String?
  rawData                Json?
  sourceFile             String?
  importedAt             DateTime  @default(now())
  meterId                String?
  meter                  Meter?    @relation(fields: [meterId], references: [id], onDelete: SetNull)

  @@unique([snapshotDate, serialNumber, manufacturer])
  @@index([serialNumber])
  @@index([meterId, snapshotDate])
}

model Reading {
  id           String         @id @default(cuid())
  meterId      String
  period       String
  previous     Float
  current      Float
  diff         Float
  createdAt    DateTime       @default(now())
  source       ReadingSource?
  status       ReadingStatus?
  /// Ідемпотентність push з мобільного додатку
  clientSyncId String?        @unique
  exportError  String?
  exportStatus ExportStatus?
  exportedAt   DateTime?
  meter        Meter          @relation(fields: [meterId], references: [id])

  @@index([meterId, period, createdAt])
}

enum ResourceType {
  COLD_WATER
  HOT_WATER
  HEATING
  ELECTRICITY
}

enum ReadingStatus {
  OK
  WARNING
  CORRECTED
  CANCELLED
}

enum ReadingSource {
  DAH
  COLLECTED
  YOURSELF
}

enum ExportStatus {
  PENDING
  SENT
  ERROR
}
